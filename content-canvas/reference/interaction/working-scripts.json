      [
       "merge",
       [
        "b",
        "m",
        "c"
       ],
       "d=8"
      ],
      [
       "unfocus"
      ]
     ]
    },
    {
     "say": "Now 3 + 8",
     "ops": [
      [
       "down"
      ],
      [
       "merge",
       [
        "a",
        "p",
        "d"
       ],
       "e=11"
      ]
     ]
    },
    {
     "say": "Answer",
     "ops": [
      [
       "box"
      ]
     ]
    }
   ],
   "mode": "expr"
  },
