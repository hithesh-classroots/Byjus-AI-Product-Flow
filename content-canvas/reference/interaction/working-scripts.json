      [
       "newline",
       "a=3 p=+ b=4 m=× c=2"
      ]
     ]
    },
    {
     "say": "× binds tighter, so 4 × 2 goes first",
     "ops": [
      [
       "down"
      ],
      [
       "focus",
       [
        "b",
        "m",
        "c"
       ]
      ]
     ]
    },
    {
     "say": "4 × 2 collapses into 8",
