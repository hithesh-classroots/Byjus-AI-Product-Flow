{
 "layer": "reference",
 "normative": false,
 "schema": "../../source/components/problem-script.schema.json",
 "note": "Sample multi-step problems. Patterns only: never reuse their numbers, objects or wording.",
 "scripts": [
  {"key":"mp-percent","thread":"Ratio and percent","title":"Discount, then tax","level":"L3","grades":"7–8","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem: the given quantities are marked","ops":[["statement","A bag costs ${q1:40}. The shop takes {q2:25}% off, then adds {q3:10}% tax to the sale price. How much does the bag cost now?"],["ledger",[{"id":"A","name":"A","label":"discount"},{"id":"B","name":"B","label":"sale price"},{"id":"C","name":"C","label":"tax"},{"id":"D","name":"D","label":"final cost"}]]]},
    {"say":"A, the discount, is 25% of 40","ops":[["newline","an=#A ae== p=25 pc=~% x=× v=40",{"from":{"p":"q2","v":"q1"}}]]},
    {"say":"25% means 25 ÷ 100; the × 40 moves next to the 25","ops":[["down"],["split","pc","dv=÷ h=100"],["move",["x","v"],{"after":"p"}]]},
    {"say":"25 × 40, then ÷ 100","ops":[["down"],["merge",["p","x","v"],"k=1000"],["down"],["merge",["k","dv","h"],"r=10"],["box"]]},
    {"say":"A goes into the knowns","ops":[["deposit","r","A","$10"]]},
    {"say":"B, the sale price, is 40 − A","ops":[["clear"],["newline","bn=#B be== v=40 m=− a=10",{"from":{"v":"q1","a":"A"}}],["role",["a"],"action"]]},
    {"say":"40 − 10","ops":[["down"],["merge",["v","m","a"],"r=30"],["box"],["deposit","r","B","$30"]]},
    {"say":"C, the tax, is 10% of B","ops":[["clear"],["newline","cn=#C ce== p=10 pc=~% x=× v=30",{"from":{"p":"q3","v":"B"}}],["role",["v"],"action"]]},
    {"say":"10% means ÷ 100","ops":[["down"],["split","pc","dv=÷ h=100"],["move",["x","v"],{"after":"p"}],["down"],["merge",["p","x","v"],"k=300"],["down"],["merge",["k","dv","h"],"r=3"],["box"],["deposit","r","C","$3"]]},
    {"say":"D, the final cost, is B + C","ops":[["clear"],["newline","dn=#D de== b=30 pl=+ c=3",{"from":{"b":"B","c":"C"}}],["role",["b","c"],"action"],["down"],["merge",["b","pl","c"],"r=33"],["box"],["deposit","r","D","$33"]]}
   ]},
  {"key":"mp-area","thread":"Geometry and measurement","title":"Area of a composite shape","level":"L2","grades":"6–7","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem and the figure","ops":[["statement","A wall is a rectangle {q1:8} m wide and {q2:5} m tall, with a triangle {q3:3} m tall on top. What is the area of the wall?"],
      ["figure",{"parts":[{"id":"rect","points":[[712,190],[840,190],[840,270],[712,270]]},{"id":"tri","points":[[712,190],[776,142],[840,190]]}],"marks":["M776 142 V190"],
        "labels":[{"id":"f8","text":"8 m","x":776,"y":284},{"id":"f5","text":"5 m","x":868,"y":230},{"id":"f3","text":"3 m","x":752,"y":174}]}],
      ["ledger",[{"id":"A","name":"A","label":"rectangle"},{"id":"B","name":"B","label":"triangle"},{"id":"C","name":"C","label":"whole wall"}],{"x":668,"y":312}]]},
    {"say":"A: the rectangle is 8 by 5","ops":[["shade","rect","concept"],["newline","an=#A ae== w=8 x=× h=5",{"from":{"w":"f8","h":"f5"}}],["down"],["merge",["w","x","h"],"r=40 ru=&m²"],["box"],["deposit","r","A","40 m²"],["shade","rect",null]]},
    {"say":"B: the triangle is half of base × height","ops":[["clear"],["shade","tri","concept"],["newline","bn=#B be== w=8 x=× h=3 dv=÷ t=2",{"from":{"w":"f8","h":"f3"}}],["down"],["merge",["w","x","h"],"k=24"],["down"],["merge",["k","dv","t"],"r=12 ru=&m²"],["box"],["deposit","r","B","12 m²"],["shade","tri",null]]},
    {"say":"C: the wall is A + B","ops":[["clear"],["shade","rect","concept"],["shade","tri","concept"],["newline","cn=#C ce== a=40 pl=+ b=12",{"from":{"a":"A","b":"B"}}],["role",["a","b"],"action"],["down"],["merge",["a","pl","b"],"r=52 ru=&m²"],["box"],["deposit","r","C","52 m²"]]}
   ]},
  {"key":"mp-speed","thread":"Rates","title":"Average speed over two legs","level":"L2","grades":"7–8","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem","ops":[["statement","A bus travels {q1:120} km in {q2:2} hours, then {q3:60} km in {q4:1} hour. What is its average speed for the whole trip?"],["ledger",[{"id":"A","name":"A","label":"total distance"},{"id":"B","name":"B","label":"total time"},{"id":"C","name":"C","label":"average speed"}]]]},
    {"say":"A: add the two distances","ops":[["newline","an=#A ae== d1=120 pl=+ d2=60",{"from":{"d1":"q1","d2":"q3"}}],["down"],["merge",["d1","pl","d2"],"r=180 ru=&km"],["box"],["deposit","r","A","180 km"]]},
    {"say":"B: add the two times","ops":[["clear"],["newline","bn=#B be== t1=2 pl=+ t2=1",{"from":{"t1":"q2","t2":"q4"}}],["down"],["merge",["t1","pl","t2"],"r=3 ru=&h"],["box"],["deposit","r","B","3 h"]]},
    {"say":"C: average speed is A ÷ B","ops":[["clear"],["newline","cn=#C ce== a=180 dv=÷ b=3",{"from":{"a":"A","b":"B"}}],["role",["a","b"],"action"],["down"],["merge",["a","dv","b"],"r=60 ru=&km/h"],["box"],["deposit","r","C","60 km/h"]]}
   ]},
  {"key":"mp-spldv","thread":"Equations","title":"Pens and books (two unknowns)","level":"L3","grades":"8–9","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem","ops":[["statement","{q1:3} pens and {q2:2} books cost ${q3:26}. One pen and {q5:2} books cost ${q6:18}. How much do {q7:5} pens and {q8:3} books cost?"],["ledger",[{"id":"A","name":"A","label":"one pen"},{"id":"B","name":"B","label":"one book"},{"id":"C","name":"C","label":"5 pens, 3 books"}]]]},
    {"say":"Each fact becomes an equation","ops":[["newline","a1=3 a2=~p ap=+ a3=2 a4=~b ae== a5=26",{"from":{"a1":"q1","a3":"q2","a5":"q3"}}],["newline","b2=p bp=+ b3=2 b4=~b be== b5=18",{"keep":true,"from":{"b3":"q5","b5":"q6"}}]]},
    {"say":"Take the second from the first: the books cancel","ops":[["rule"],["sum",[{"ids":["a1","a2","b2"],"spec":"s1=2 s2=~p"},{"ids":["ap","a3","a4","bp","b3","b4"]},{"ids":["ae","be"],"spec":"se=="},{"ids":["a5","b5"],"spec":"s5=8"}]]]},
    {"say":"2 leaves p as a divisor","ops":[["down"],["move",["s1"],{"end":true},{"prefix":"dv=÷"}],["merge",["s5","dv","s1"],"r=4"],["box"],["deposit","r","A","$4"]]},
    {"say":"B: A goes back into the second fact","ops":[["clear"],["newline","c1=4 cp=+ c3=2 c4=~b ce== c6=18",{"from":{"c1":"A","c3":"q5","c6":"q6"}}],["role",["c1"],"action"]]},
    {"say":"4 crosses over; then 2 divides","ops":[["down"],["move",["c1"],{"end":true},{"prefix":"cm=−","drop":["cp"]}],["merge",["c6","cm","c1"],"k=14"],["down"],["move",["c3"],{"end":true},{"prefix":"dv=÷"}],["merge",["k","dv","c3"],"r=7"],["box"],["deposit","r","B","$7"]]},
    {"say":"C: 5 pens and 3 books","ops":[["clear"],["newline","cn=#C ce== d1=5 dx=× da=4 dp=+ d3=3 dy=× db=7",{"from":{"d1":"q7","da":"A","d3":"q8","db":"B"}}],["role",["da","db"],"action"],["down"],["merge",["d1","dx","da"],"m1=20"],["merge",["d3","dy","db"],"m2=21"],["down"],["merge",["m1","dp","m2"],"r=41"],["box"],["deposit","r","C","$41"]]}
   ]},
  {"key":"mp-mean","thread":"Statistics","title":"The missing score from two means","level":"L2","grades":"7–8","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem","ops":[["statement","The mean of {q1:4} test scores is {q2:75}. After a fifth test, the mean of all {q3:5} scores is {q4:78}. What was the fifth score?"],["ledger",[{"id":"A","name":"A","label":"total of 4"},{"id":"B","name":"B","label":"total of 5"},{"id":"C","name":"C","label":"fifth score"}]]]},
    {"say":"A: a mean times the count gives the total","ops":[["newline","an=#A ae== n=4 x=× m=75",{"from":{"n":"q1","m":"q2"}}],["down"],["merge",["n","x","m"],"r=300"],["box"],["deposit","r","A","300"]]},
    {"say":"B: the same for all five","ops":[["clear"],["newline","bn=#B be== n=5 x=× m=78",{"from":{"n":"q3","m":"q4"}}],["down"],["merge",["n","x","m"],"r=390"],["box"],["deposit","r","B","390"]]},
    {"say":"C: the fifth score is what B adds to A","ops":[["clear"],["newline","cn=#C ce== b=390 mi=− a=300",{"from":{"b":"B","a":"A"}}],["role",["a","b"],"action"],["down"],["merge",["b","mi","a"],"r=90"],["box"],["deposit","r","C","90"]]}
   ]},
  {"key":"mp-recipe","thread":"Ratio and proportion","title":"Scaling a recipe (unitary method)","level":"L1","grades":"6–7","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem","ops":[["statement","A recipe for {q1:4} people uses {q2:300} g of flour. How much flour is needed for {q3:10} people?"],["ledger",[{"id":"A","name":"A","label":"for 1 person"},{"id":"B","name":"B","label":"for 10 people"}]]]},
    {"say":"A: share the flour among 4","ops":[["newline","an=#A ae== f=300 dv=÷ n=4",{"from":{"f":"q2","n":"q1"}}],["down"],["merge",["f","dv","n"],"r=75 ru=&g"],["box"],["deposit","r","A","75 g"]]},
    {"say":"B: ten people need ten times A","ops":[["clear"],["newline","bn=#B be== a=75 x=× n=10",{"from":{"a":"A","n":"q3"}}],["role",["a"],"action"],["down"],["merge",["a","x","n"],"r=750 ru=&g"],["box"],["deposit","r","B","750 g"]]}
   ]},
  {"key":"mp-perimeter","thread":"Geometry and measurement","title":"Hypotenuse, then perimeter","level":"L3","grades":"8","mode":"eq","layout":"problem",
   "steps":[
    {"say":"Read the problem and the figure","ops":[["statement","A right triangle has legs {q1:6} cm and {q2:8} cm long. What is its perimeter?"],
      ["figure",{"parts":[{"id":"tri","points":[[712,262],[712,166],[868,262]]}],"marks":["M712 248 h14 v14"],
        "labels":[{"id":"f6","text":"6 cm","x":684,"y":214},{"id":"f8","text":"8 cm","x":790,"y":280}]}],
      ["ledger",[{"id":"A","name":"A","label":"longest side"},{"id":"B","name":"B","label":"perimeter"}],{"x":668,"y":312}]]},
    {"say":"A: the longest side comes from Pythagoras","ops":[["shade","tri","concept"],["newline","c=c ce=^2 e== a=6 ae=^2 p=+ b=8 be=^2",{"from":{"a":"f6","b":"f8"}}],["down"],["merge",["a","ae"],"a2=36"],["merge",["b","be"],"b2=64"],["down"],["merge",["a2","p","b2"],"s=100"]]},
    {"say":"Root both sides","ops":[["down"],["tight","c",true],["tight","s",true],["insert","r1=√",{"start":true}],["insert","r2=√",{"after":"e"}],["down"],["merge",["r1","c","ce"],"cc=c"],["merge",["r2","s"],"t=10 tu=&cm"],["box"],["deposit","t","A","10 cm"],["shade","tri",null]]},
    {"say":"B: the perimeter adds all three sides","ops":[["clear"],["newline","bn=#B be== a=6 p1=+ b=8 p2=+ h=10",{"from":{"a":"q1","b":"q2","h":"A"}}],["role",["h"],"action"],["down"],["merge",["a","p1","b","p2","h"],"r=24 ru=&cm"],["box"],["deposit","r","B","24 cm"]]}
   ]}
 ]
}
